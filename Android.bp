dirgroup {
    name: "trusty_dirgroup_trusty_device_desktop",
    dirs: ["."],
    visibility: ["//trusty/vendor/google/aosp/scripts"],
}

rust_binary_host {
    name: "desktop_trusty_signing_tool",
    srcs: ["desktop_trusty_signing_tool.rs"],
    rustlibs: [
        "libclap",
        "libelf_rust",
        "liblog_rust",
        "libtempfile",
    ],
}
